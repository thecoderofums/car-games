<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Car Racing Game</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      background-color: #f0f0f0;
    }

    #gameArea {
      position: relative;
      width: 600px;
      height: 400px;
      background-color: #d3d3d3;
      border: 2px solid #000;
      overflow: hidden;
    }

    #track {
      position: absolute;
      width: 100%;
      height: 100%;
      background-color: #a0a0a0;
      border: 2px solid #000;
      border-radius: 15px;
    }

    #car {
      position: absolute;
      z-index: 1; /* stay above #track, which is painted after it */
      width: 40px;
      height: 80px;
      background-color: red;
      border-radius: 5px;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
    }
  </style>
</head>
<body>
  <div id="gameArea">
    <div id="car"></div>
    <div id="track"></div>
  </div>

  <script>
    // JavaScript Code

    const car = document.getElementById('car');
    const gameArea = document.getElementById('gameArea');

    let carSpeed = 0;
    const maxSpeed = 5;
    const acceleration = 0.1;
    const turnSpeed = 5;
    let carAngle = 0;

    let gameInterval;

    function startGame() {
      gameInterval = setInterval(() => {
        moveCar();
      }, 20); // Update every 20ms
    }

    function moveCar() {
      // Move forward by speed
      let radianAngle = carAngle * (Math.PI / 180);
      let currentX = parseInt(car.style.left || 0);
      let currentY = parseInt(car.style.bottom || 0);

      currentX += carSpeed * Math.cos(radianAngle);
      currentY += carSpeed * Math.sin(radianAngle);

      // Boundaries check
      if (currentX < 0) currentX = 0;
      if (currentX > gameArea.clientWidth - car.offsetWidth) currentX = gameArea.clientWidth - car.offsetWidth;
      if (currentY < 0) currentY = 0;
      if (currentY > gameArea.clientHeight - car.offsetHeight) currentY = gameArea.clientHeight - car.offsetHeight;

      car.style.left = currentX + 'px';
      car.style.bottom = currentY + 'px';
    }

    function accelerateCar() {
      carSpeed = Math.min(carSpeed + acceleration, maxSpeed); // Increase speed up to maxSpeed
    }

    function brakeCar() {
      carSpeed = Math.max(carSpeed - acceleration, 0); // Decrease speed to zero
    }

    function turnLeft() {
      carAngle -= turnSpeed;
      if (carAngle < 0) carAngle = 360;
    }

    function turnRight() {
      carAngle += turnSpeed;
      if (carAngle >= 360) carAngle = 0;
    }

    // Key press handlers
    document.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowUp') {
        accelerateCar();
      }
      if (event.key === 'ArrowDown') {
        brakeCar();
      }
      if (event.key === 'ArrowLeft') {
        turnLeft();
      }
      if (event.key === 'ArrowRight') {
        turnRight();
      }
    });

    // Start the game when page loads
    window.onload = startGame;
  </script>
</body>
</html>
